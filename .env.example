# Google Cloud / Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Parallel AI API Key (from parallel.ai or hackathon resources)
PARALLEL_API_KEY=your_parallel_api_key_here

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Public deploy hardening (set true on hosted demo)
# When true: OpenAPI /docs disabled, health payload minimized, Secure cookies
CUECLEAR_PUBLIC=false

# Comma-separated browser origins allowed to call the API with cookies
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Upload / clearance guards
MAX_UPLOAD_BYTES=5242880
MAX_CUES_PER_RUN=40
CLEARANCE_RATE_LIMIT=5
CLEARANCE_RATE_WINDOW_SEC=60
SESSION_TTL_SEC=86400
